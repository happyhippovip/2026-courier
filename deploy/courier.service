[Unit]
Description=Courier external background supervisor
Documentation=https://github.com/happyhippovip/2026-courier
After=network.target
Wants=network.target
ConditionPathExists=/etc/courier/courier.env

[Service]
Type=simple
User=courier
Group=courier
WorkingDirectory=/opt/courier
EnvironmentFile=/etc/courier/courier.env
EnvironmentFile=-/etc/courier/courier.secrets
ExecStart=/opt/courier/deploy/run-supervisor.sh
Restart=on-failure
RestartSec=30s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/courier
StateDirectory=courier
StateDirectoryMode=0750
LogNamespace=courier
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
