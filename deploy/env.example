# Non-secret runtime configuration for /etc/courier/courier.env.
# Put provider credentials only in /etc/courier/courier.secrets (mode 0600).
COURIER_STATE_DIR=/var/lib/courier
COURIER_MEMORY_REPO=/var/lib/courier/memory
COURIER_POLL_SECONDS=60
COURIER_MAX_TASKS=10
COURIER_MAX_RUNTIME_MINUTES=60
COURIER_MAX_RETRIES_PER_TASK=2
COURIER_REPORT_RETENTION_DAYS=30

# Keep memory writes disabled until an operator explicitly configures the
# external memory repository and approves enabling them.
COURIER_MEMORY_DRY_RUN=true

# Existing worker/provider processes inherit variables from courier.secrets.
# Examples (leave values out of this repository):
# GITHUB_TOKEN=
# OPENAI_API_KEY=
