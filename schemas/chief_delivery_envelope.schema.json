{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief Delivery Adapter envelope",
  "description": "A channel-neutral prepared delivery record. PREPARED_NOT_DELIVERED never claims a Chief transport channel exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "proposal_id", "correlation_id", "destination", "delivery_status", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "chief-delivery-1.0"},
    "delivery_id": {"type": "string"},
    "proposal_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "destination": {"type": "string", "const": "CHIEF_UNVERIFIED_CHANNEL"},
    "delivery_status": {"type": "string", "const": "PREPARED_NOT_DELIVERED"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
