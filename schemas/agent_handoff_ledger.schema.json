{
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/agent_handoff_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "courier-agent-handoff-ledger"
    },
    "history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "changed_fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "entry_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "operation": {
            "enum": [
              "INIT",
              "UPDATE"
            ]
          },
          "previous_entry_sha256": {
            "oneOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "record": {
            "$ref": "#/$defs/record"
          },
          "record_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "revision": {
            "minimum": 0,
            "type": "integer"
          },
          "timestamp_utc": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "timestamp_utc",
          "updated_by",
          "operation",
          "changed_fields",
          "record",
          "record_sha256",
          "previous_entry_sha256",
          "entry_sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "non_authority": {
      "const": "Coordination metadata only; this ledger has no scheduler, runtime, execution, dispatch, verification, or Courier truth authority."
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "format",
    "schema_version",
    "revision",
    "non_authority",
    "record",
    "history"
  ],
  "title": "Courier Agent Handoff Ledger",
  "type": "object",
  "$defs": {
    "count": {
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "ACTIVE_WRITERS": {
          "$ref": "#/$defs/stringList"
        },
        "BLOCKER_OWNER": {
          "minLength": 1,
          "type": "string"
        },
        "BRANCH": {
          "minLength": 1,
          "type": "string"
        },
        "CLEAN_IDLE": {
          "$ref": "#/$defs/tristate"
        },
        "COLLISION_SCOPE": {
          "$ref": "#/$defs/stringList"
        },
        "CONTINUATION_CHECKPOINT": {
          "minLength": 1,
          "type": "string"
        },
        "CURRENT_SHA": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "const": "UNKNOWN"
            }
          ]
        },
        "DUPLICATE_EXTERNAL_EFFECTS": {
          "$ref": "#/$defs/count"
        },
        "FIRST_CAUSAL_BLOCKER": {
          "minLength": 1,
          "type": "string"
        },
        "GOAL": {
          "minLength": 1,
          "type": "string"
        },
        "GOALS_SUBMITTED": {
          "$ref": "#/$defs/count"
        },
        "LAST_EVIDENCE": {
          "items": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "type": "array"
        },
        "LAST_UPDATED_BY": {
          "minLength": 1,
          "type": "string"
        },
        "MANUAL_PROCESS_RESTARTS": {
          "$ref": "#/$defs/count"
        },
        "NEXT_EXECUTABLE_ACTION": {
          "minLength": 1,
          "type": "string"
        },
        "PROJECT": {
          "minLength": 1,
          "type": "string"
        },
        "PROVEN_EDGES": {
          "$ref": "#/$defs/stringList"
        },
        "QUEUE_INDEPENDENT": {
          "$ref": "#/$defs/tristate"
        },
        "RUNTIME_IDENTITY": {
          "minLength": 1,
          "type": "string"
        },
        "RUNTIME_OWNER": {
          "minLength": 1,
          "type": "string"
        },
        "STATUS": {
          "minLength": 1,
          "type": "string"
        },
        "TASKS_COMPLETED": {
          "$ref": "#/$defs/count"
        },
        "TEMP_TASK_PROCESSES_AFTER_DONE": {
          "$ref": "#/$defs/count"
        },
        "UNPROVEN_EDGES": {
          "$ref": "#/$defs/stringList"
        },
        "USER_CONTINUE_MESSAGES": {
          "$ref": "#/$defs/count"
        },
        "WORKERS_USED": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "PROJECT",
        "GOAL",
        "CURRENT_SHA",
        "BRANCH",
        "RUNTIME_IDENTITY",
        "RUNTIME_OWNER",
        "STATUS",
        "PROVEN_EDGES",
        "UNPROVEN_EDGES",
        "FIRST_CAUSAL_BLOCKER",
        "BLOCKER_OWNER",
        "NEXT_EXECUTABLE_ACTION",
        "ACTIVE_WRITERS",
        "COLLISION_SCOPE",
        "GOALS_SUBMITTED",
        "TASKS_COMPLETED",
        "WORKERS_USED",
        "USER_CONTINUE_MESSAGES",
        "MANUAL_PROCESS_RESTARTS",
        "DUPLICATE_EXTERNAL_EFFECTS",
        "TEMP_TASK_PROCESSES_AFTER_DONE",
        "CLEAN_IDLE",
        "QUEUE_INDEPENDENT",
        "LAST_EVIDENCE",
        "LAST_UPDATED_BY",
        "CONTINUATION_CHECKPOINT"
      ],
      "type": "object"
    },
    "stringList": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "tristate": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    }
  }
}
