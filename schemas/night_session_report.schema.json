{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NightSessionReport",
  "description": "Structured session report produced by the Autonomous Night Supervisor (093)",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "started_at",
    "finished_at",
    "tasks_completed",
    "tasks_failed",
    "human_gates",
    "memory_updates_applied",
    "memory_updates_queued_for_review",
    "commits_created",
    "pushes_completed",
    "next_queued_tasks",
    "cost",
    "stop_reason"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^night-sess-[A-Za-z0-9_.-]+$"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "tasks_completed": {
      "type": "integer",
      "minimum": 0
    },
    "tasks_failed": {
      "type": "integer",
      "minimum": 0
    },
    "human_gates": {
      "type": "integer",
      "minimum": 0
    },
    "memory_updates_applied": {
      "type": "integer",
      "minimum": 0
    },
    "memory_updates_queued_for_review": {
      "type": "integer",
      "minimum": 0
    },
    "commits_created": {
      "type": "integer",
      "minimum": 0
    },
    "pushes_completed": {
      "type": "integer",
      "minimum": 0
    },
    "next_queued_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "string",
      "const": "0.00 EUR"
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "QUEUE_EMPTY",
        "MAX_TASKS_REACHED",
        "MAX_RUNTIME_EXCEEDED",
        "HUMAN_GATE_ENCOUNTERED",
        "CRITICAL_BLOCK"
      ]
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
