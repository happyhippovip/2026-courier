{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief Courier Command",
  "description": "Canonical schema for structured Chief / ChatGPT commands relayed to Antigravity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "task_id",
    "correlation_id",
    "parent_id",
    "source",
    "destination",
    "type",
    "status",
    "created_at",
    "payload",
    "payload_hash",
    "max_iterations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "const": "chief"
    },
    "destination": {
      "type": "string",
      "const": "antigravity"
    },
    "type": {
      "type": "string",
      "const": "COMMAND"
    },
    "status": {
      "type": "string",
      "const": "NEW"
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_agent",
        "one_next_command",
        "allowed_scope",
        "human_gate_policy",
        "cost_policy"
      ],
      "properties": {
        "target_agent": {
          "type": "string",
          "const": "ANTIGRAVITY"
        },
        "one_next_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "allowed_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_gate_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cost_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_iterations": {
      "type": "integer",
      "const": 1
    }
  }
}
