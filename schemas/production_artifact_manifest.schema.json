{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductionArtifactManifest",
  "description": "Schema for persistent content production pipeline stage manifests and publish packages (095)",
  "type": "object",
  "required": [
    "schema_version",
    "mission_id",
    "channel_id",
    "workflow_id",
    "platform",
    "content_project",
    "topic",
    "overall_status",
    "stages",
    "artifacts",
    "review_result",
    "publish_package",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^prod-[a-z0-9_.-]+$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^chan-[a-z0-9_.-]+$"
    },
    "workflow_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "YOUTUBE",
        "TIKTOK"
      ]
    },
    "content_project": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "HUMAN_GATE",
        "PARTIAL_COMPLETED"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "executed_at"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "NOT_IMPLEMENTED",
              "ENVIRONMENT_GATE",
              "HUMAN_GATE",
              "FAILED",
              "SKIPPED"
            ]
          },
          "executed_at": {
            "type": "string"
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "artifact_name",
          "relative_path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "artifact_name": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "review_result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "technical_checks_passed": {
          "type": "boolean"
        },
        "secrets_detected": {
          "type": "integer"
        },
        "missing_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "HUMAN_GATE_REQUIRED"
          ]
        }
      }
    },
    "publish_package": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "package_ready": {
          "type": "boolean"
        },
        "publishing_policy": {
          "type": "string",
          "const": "REQUIRE_EXPLICIT_HUMAN_APPROVAL"
        },
        "staged_metadata": {
          "type": "object"
        },
        "artifact_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "updated_at": {
      "type": "string"
    }
  }
}
