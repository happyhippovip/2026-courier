{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeAlert",
  "type": "object",
  "required": [
    "schema_version", "message_id", "agent_id", "task_id", "workflow_id",
    "correlation_id", "process", "elapsed_seconds", "last_progress_at",
    "classification", "reason", "evidence", "recommended_next_action", "created_at", "dedupe_key"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "message_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "const": "agent-snitch"},
    "task_id": {"type": ["string", "null"]},
    "workflow_id": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "process": {"type": "object"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "last_progress_at": {"type": ["string", "null"]},
    "classification": {"type": "string", "enum": ["SUSPECTED_STALL", "STALLED", "BLOCKED"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "object"},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dedupe_key": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
