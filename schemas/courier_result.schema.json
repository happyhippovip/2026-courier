{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Courier Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "task_id", "correlation_id", "parent_id", "source", "destination", "type", "status", "created_at", "payload", "payload_hash", "max_iterations"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "message_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "parent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "const": "codex" },
    "destination": { "const": "github_courier" },
    "type": { "const": "RESULT" },
    "status": { "const": "DONE" },
    "created_at": { "type": "string", "minLength": 20, "maxLength": 64 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": { "result": { "enum": ["COURIER_CODEX_ACK", "COURIER_SEQUENTIAL_ACK", "COURIER_AUTOMATIC_ACK"] } }
    },
    "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "max_iterations": { "const": 1 }
  }
}
