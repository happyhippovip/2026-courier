{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentWorkflowRegistry",
  "description": "Schema for content production workflow definitions and stage mappings (094)",
  "type": "object",
  "required": [
    "schema_version",
    "workflows",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "updated_at": {
      "type": "string"
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "platform",
          "content_project",
          "content_type",
          "production_steps",
          "review_policy",
          "publish_gate",
          "night_supervisor_enabled",
          "zero_cost_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "workflow_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "YOUTUBE",
              "TIKTOK"
            ]
          },
          "content_project": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "9:16_VERTICAL_SHORT",
              "16:9_HORIZONTAL_VIDEO"
            ]
          },
          "production_steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3
          },
          "review_policy": {
            "type": "string"
          },
          "publish_gate": {
            "type": "string",
            "const": "REQUIRE_EXPLICIT_HUMAN_APPROVAL"
          },
          "night_supervisor_enabled": {
            "type": "boolean"
          },
          "zero_cost_policy": {
            "type": "string",
            "const": "ZERO_COST_ONLY"
          }
        }
      }
    }
  }
}
