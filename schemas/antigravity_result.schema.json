{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antigravity Courier Result",
  "description": "Canonical schema for structured Antigravity results relayed to Chief / ChatGPT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "task_id",
    "correlation_id",
    "parent_id",
    "source",
    "destination",
    "type",
    "status",
    "created_at",
    "payload",
    "payload_hash",
    "max_iterations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "const": "antigravity"
    },
    "destination": {
      "type": "string",
      "const": "chief"
    },
    "type": {
      "type": "string",
      "const": "RESULT"
    },
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "FAILED",
        "BLOCKED"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_agent",
        "summary",
        "verified_facts",
        "files_changed",
        "commits",
        "test_results",
        "cost",
        "human_gate",
        "safe_next_state"
      ],
      "properties": {
        "source_agent": {
          "type": "string",
          "const": "ANTIGRAVITY"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "verified_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_results": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cost": {
          "type": "string"
        },
        "human_gate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "safe_next_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_iterations": {
      "type": "integer",
      "const": 1
    }
  }
}
