{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryUpdateApproval",
  "description": "Explicit, schema-validated Chief Approval contract authorizing execution of a MemoryUpdateProposal",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "proposal_id",
    "source_result_message_id",
    "task_id",
    "correlation_id",
    "memory_base_commit",
    "approved_by",
    "approval_status",
    "approved_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^appr-mem-[A-Za-z0-9_.-]+$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prop-mem-[A-Za-z0-9_.-]+$"
    },
    "source_result_message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "memory_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "APPROVED"
      ]
    },
    "approved_changes_count": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    }
  }
}
