{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SocialChannelRegistry",
  "description": "Registry schema for social media channels (YouTube, TikTok) with workflow binding and zero credential storage (094)",
  "type": "object",
  "required": [
    "schema_version",
    "channels",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "updated_at": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "platform",
          "channel_label",
          "content_project",
          "workflow_id",
          "automation_status",
          "production_enabled",
          "publishing_policy",
          "credential_reference_metadata",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "type": "string",
            "pattern": "^chan-[a-z0-9_.-]+$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "YOUTUBE",
              "TIKTOK"
            ]
          },
          "channel_label": {
            "type": "string",
            "minLength": 2
          },
          "content_project": {
            "type": "string",
            "enum": [
              "FruitKI",
              "3D-KI-Videos",
              "FruitKI-YouTube",
              "3D-KI-TikTok",
              "NEW_CHANNEL_PENDING"
            ]
          },
          "workflow_id": {
            "type": "string",
            "enum": [
              "fruitki-youtube",
              "3d-ai-tiktok",
              "generic-staging-workflow"
            ]
          },
          "automation_status": {
            "type": "string",
            "enum": [
              "ACTIVE_AUTOMATION",
              "READY_FOR_AUTOMATION",
              "NEW_CHANNEL_PENDING",
              "HUMAN_AUTH_REQUIRED",
              "PAUSED",
              "DISABLED"
            ]
          },
          "production_enabled": {
            "type": "boolean"
          },
          "publishing_policy": {
            "type": "string",
            "const": "REQUIRE_EXPLICIT_HUMAN_APPROVAL"
          },
          "credential_reference_metadata": {
            "type": "string",
            "description": "Non-sensitive metadata name referencing external Keychain or environment secret only; no raw tokens allowed."
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
