#!/usr/bin/env python3
"""{{NAME}} — a Muse daemon connector for {{SOURCE_NAME}} (scaffolded by the
`connector-author` skill from the daemon's starter template; ADR 37480 D1/D12).

The MECHANICS below are the template's and satisfy the daemon's three rules
before any stub is filled (`connector_conformance.py` proves them):

1. ownership is the daemon's — this script mints an opaque `conversation` id
   per {{CONVERSATION_UNIT}} and a per-connector alias `c<n>`; it never
   reads the registry;
2. `listen` runs under a Monitor and prints one feed line per inbound
   message, `c<n> <sender>: <text>`, and nothing else on stdout;
3. `listen` refuses a second live listener for the same subscription key
   (`source`, `filter`) — and an OVERLAPPING filter on the same source (ADR
   37480 D8) — naming the live one; `reply` is idempotent on `--key`.

The SOURCE-SPECIFIC bodies are the stubs marked `TODO(answer <id>)`: each
marker names the interview answer (`tests/answers.json`) that fills it. Keep
the `FIXTURE_FILE` branches: they are what `tests/` and `check` drive.

Environment: `{{ENV_PREFIX}}STATE_DIR` (state; default
`$XDG_DATA_HOME/muse/connectors/{{NAME}}`), `{{ENV_PREFIX}}FIXTURE_FILE`
(tests only: a JSON inbox/outbox instead of the real source),
`{{ENV_PREFIX}}POLL_S` (poll interval), `{{ENV_PREFIX}}HANDLE` (what a
mention of you looks like; default `{{HANDLE}}`){{AUTH_ENV_DOC}}. Stdlib only.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

CONNECTOR_ID = "{{NAME}}"
ENV_PREFIX = "{{ENV_PREFIX}}"
SOURCE = "{{SOURCE_WORD}}"            # the `--source` word `listen` takes
SOURCES_AVAILABLE = [SOURCE]          # every `--source` word `listen` honours; `status --json` declares it
DELIVERY = "{{DELIVERY}}"             # poll | push
DEFAULT_FILTER = "{{DEFAULT_FILTER}}"  # ADR 37480 D5 item 5: "addressed to me" by default
POLL_COMMAND = {{POLL_COMMAND}}       # TODO(answer poll.command): the command that lists new events
PUSH_PORT = {{PUSH_PORT}}             # TODO(answer push.port): where the source posts events
REPLY_COMMAND = {{REPLY_COMMAND}}     # TODO(answer reply.command): posts <text> into <conversation>
ENV_PASS = {{ENV_PASS}}               # answer auth.env: names a coordinator lane needs (never values)
HANDLE = os.environ.get(ENV_PREFIX + "HANDLE", "{{HANDLE}}")
POLL_S = float(os.environ.get(ENV_PREFIX + "POLL_S", "{{POLL_S}}"))
FIXTURE_FILE = os.environ.get(ENV_PREFIX + "FIXTURE_FILE")


def state_dir() -> Path:
    explicit = os.environ.get(ENV_PREFIX + "STATE_DIR")
    if explicit:
        return Path(explicit)
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return Path(base) / "muse" / "connectors" / CONNECTOR_ID


def emit(payload: dict, code: int = 0) -> None:
    # `outcome` first: a Monitor note shows the head of a long line.
    print(json.dumps(payload), flush=True)
    sys.exit(code)


class State:
    """Read-modify-write of `state.json` under an flock on a sidecar lock file
    (never the state file itself: the atomic publish below swaps its inode)."""

    def __init__(self) -> None:
        self.path = state_dir() / "state.json"
        self.lock_path = self.path.with_name("state.lock")

    def __enter__(self) -> dict:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.lock_fh = open(self.lock_path, "a+", encoding="utf-8")
        fcntl.flock(self.lock_fh, fcntl.LOCK_EX)
        self.before = self.path.read_text(encoding="utf-8") if self.path.exists() else ""
        self.data = json.loads(self.before) if self.before.strip() else {}
        for key in ("aliases", "cursors", "outbound", "control", "last"):
            self.data.setdefault(key, [] if key == "outbound" else {})
        return self.data

    def __exit__(self, *exc) -> None:
        if exc[0] is None:
            encoded = json.dumps(self.data, sort_keys=True)
            if encoded != self.before:
                tmp = self.path.with_name("state.json.tmp")
                tmp.write_text(encoded, encoding="utf-8")
                os.replace(tmp, self.path)
        fcntl.flock(self.lock_fh, fcntl.LOCK_UN)
        self.lock_fh.close()


# --- rule 3, listen side: one live listener per subscription key -----------

def lock_dir() -> Path:
    path = state_dir() / "listeners"
    path.mkdir(parents=True, exist_ok=True)
    return path


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def ended_path(lock: Path) -> Path:
    # Beside the key's lock: how its last listener ended (`exit`, `ended_at`),
    # written on a non-zero end, dropped by a clean end or the next listen.
    return lock.with_suffix(".ended")


def note_listener_end(lock: Path, source: str, filt: str, code: int) -> None:
    if code == 0:
        ended_path(lock).unlink(missing_ok=True)
        return
    # The key travels in the record (the file name is not parsed back: a
    # filter may contain `--` or be `_`), and the record lands whole in one
    # rename: the daemon's `start` runs `status` in a separate process and
    # must never read a half-written file.
    tmp = ended_path(lock).with_suffix(".ended.tmp")
    tmp.write_text(json.dumps({"source": source, "filter": filt, "exit": code,
                               "ended_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}))
    os.replace(tmp, ended_path(lock))


def ended_listeners() -> list[dict]:
    """`{"source", "filter", "exit", "ended_at"}` per key whose last listener
    ended non-zero. The daemon's `start` writes `last_arm` from these fields
    without a model call; a stop by signal leaves none (a stop is no failure)."""
    ended = []
    for path in sorted(lock_dir().glob("*.ended")):
        try:
            record = json.loads(path.read_text())
        except ValueError:
            continue  # not a record; never the reader's to delete
        if (isinstance(record, dict) and isinstance(record.get("source"), str) and isinstance(record.get("filter"), str)
                and isinstance(record.get("exit"), int) and record["exit"] != 0 and isinstance(record.get("ended_at"), str)):
            ended.append({key: record[key] for key in ("source", "filter", "exit", "ended_at")})
    return ended


def live_listeners() -> list[dict]:
    live = []
    for path in sorted(lock_dir().glob("*.json")):
        try:
            record = json.loads(path.read_text())
        except ValueError:
            path.unlink(missing_ok=True)
            continue
        if pid_alive(int(record.get("pid", 0))):
            live.append(record)
        else:
            path.unlink(missing_ok=True)
    return live


def filters_overlap(a: str, b: str) -> bool:
    # A filter is one word; "" means everything. Two subscriptions on one
    # source are disjoint only when both are non-empty and different.
    return a == b or not a or not b


# --- aliases: one `c<n>` per conversation, this connector's own counter ----

def alias_for(data: dict, conversation: str) -> str:
    aliases = data["aliases"]
    if conversation not in aliases:
        aliases[conversation] = f"c{len(aliases) + 1}"
    return aliases[conversation]


def conversation_for(data: dict, alias: str) -> str | None:
    for conversation, known in data["aliases"].items():
        if known == alias:
            return conversation
    return None


def matches(text: str, filt: str) -> bool:
    # TODO(answer filters.meaning): what "addressed to me" means on {{SOURCE_NAME}}.
    # The template reads `mention` as "my handle appears in the text"; any
    # other word is a case-insensitive substring; "" is everything.
    if filt == "mention":
        return HANDLE.lower() in text.lower()
    return not filt or filt.lower() in text.lower()


# --- the source-specific stubs ---------------------------------------------

def fixture() -> dict | None:
    if not FIXTURE_FILE:
        return None
    path = Path(FIXTURE_FILE)
    return json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {"inbound": {}, "outbound": []}


def fetch_events(cursor: int) -> list[dict]:
    """New events after `cursor`, each `{"id", "sender", "text", "conversation"}`
    (`conversation` is the stable id of one {{CONVERSATION_UNIT}}; the
    registry keys on it). Return [] when nothing is new."""
    fx = fixture()
    if fx is not None:
        return list(fx.get("inbound", {}).get(SOURCE, []))[cursor:]
    if DELIVERY == "poll":
        if not POLL_COMMAND:
            # TODO(answer poll.command): run the command that lists new events and
            # TODO(answer poll.output): parse its output into the dicts above.
            raise NotImplementedError("fill fetch_events: answer poll.command / poll.output")
        proc = subprocess.run(shlex.split(POLL_COMMAND.replace("{cursor}", str(cursor))),
                              capture_output=True, text=True, check=False)
        if proc.returncode != 0:
            print(f"poll failed (exit {proc.returncode}): {proc.stderr.strip()[:200]}", file=sys.stderr, flush=True)
            return []
        events = []
        for line in proc.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line))  # TODO(answer poll.output): adapt when the command prints another shape
            except ValueError:
                events.append({"id": hashlib.sha1(line.encode()).hexdigest()[:12], "sender": "someone",
                               "text": line, "conversation": SOURCE})
        return events[cursor:] if POLL_COMMAND.find("{cursor}") < 0 else events
    # push: events arrive through the local endpoint and are queued in state
    with State() as data:
        queued = list(data.setdefault("inbox", []))
    return queued[cursor:]


def send_reply(conversation: str, text: str) -> dict:
    """Post `text` into one {{CONVERSATION_UNIT}}; return what the source said
    (any JSON-able dict). Raise on failure so the receipt records nothing."""
    fx = fixture()
    if fx is not None:
        fx.setdefault("outbound", []).append({"conversation": conversation, "text": text})
        Path(FIXTURE_FILE).write_text(json.dumps(fx))
        return {"fixture": True}
    if not REPLY_COMMAND:
        # TODO(answer reply.command): the verb that posts into {{SOURCE_NAME}}.
        raise NotImplementedError("fill send_reply: answer reply.command")
    argv = [part.replace("{conversation}", conversation).replace("{text}", text)
            for part in shlex.split(REPLY_COMMAND)]
    proc = subprocess.run(argv, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise RuntimeError(f"reply failed (exit {proc.returncode}): {proc.stderr.strip()[:200]}")
    return {"stdout": proc.stdout.strip()[:200]}


def describe_conversation(conversation: str) -> dict:
    """Extra facts about one {{CONVERSATION_UNIT}} for `describe --to c<n>`
    (a URL, a title). TODO(answer conversation.id_rule): fill from the source."""
    return {}


def serve_push(stop_flag: dict) -> None:
    """Accept the source's POSTs on PUSH_PORT and queue them for the loop.
    TODO(answer push.payload): map the source's payload to the event dict."""
    from http.server import BaseHTTPRequestHandler, HTTPServer
    import threading

    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):  # noqa: N802
            raw = self.rfile.read(int(self.headers.get("Content-Length") or 0))
            try:
                event = json.loads(raw or b"{}")
            except ValueError:
                self.send_response(400); self.end_headers(); return
            with State() as data:
                data.setdefault("inbox", []).append(event)
            self.send_response(204); self.end_headers()

        def log_message(self, *_a):  # quiet: stdout is the feed
            return

    server = HTTPServer(("127.0.0.1", PUSH_PORT or 0), Handler)
    print(f"push endpoint http://127.0.0.1:{server.server_port}/ pid={os.getpid()}", file=sys.stderr, flush=True)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    stop_flag["server"] = server


# --- verbs -------------------------------------------------------------------

def cmd_listen(args: argparse.Namespace) -> None:
    source = args.source or SOURCE
    filt = args.filter if args.filter is not None else DEFAULT_FILTER
    key = f"{source}|{filt}"
    for record in live_listeners():
        if record["source"] != source:
            continue
        live = {"pid": record["pid"], "source": record["source"], "filter": record["filter"]}
        if record["filter"] == filt:
            emit({"outcome": "listener_conflict", "connector": CONNECTOR_ID, "key": key, "live": live,
                  "hint": "another listener is live for this subscription; arm nothing else"}, 3)
        if filters_overlap(record["filter"], filt):
            emit({"outcome": "filter_overlap", "connector": CONNECTOR_ID, "key": key, "live": live,
                  "hint": "concurrent subscriptions on one source need disjoint filters"}, 3)
    lock = lock_dir() / f"{source}--{filt or '_'}.json"
    lock.write_text(json.dumps({"pid": os.getpid(), "source": source, "filter": filt}))
    ended_path(lock).unlink(missing_ok=True)  # this listener is the key's newest; an older end is history
    with State() as data:
        data["control"].pop("stop", None)  # a new listen clears the observed-down flag
    stop_flag: dict = {}

    def request_stop(*_sig) -> None:
        # Only a flag: the loop stops between polls, never while it holds the
        # state lock (a push handler waiting on that lock would deadlock a
        # `server.shutdown()` issued from inside it).
        stop_flag["requested"] = True

    def stop() -> None:
        lock.unlink(missing_ok=True)
        server = stop_flag.get("server")
        if server is not None:
            server.shutdown()
        print("stopping the listener", file=sys.stderr, flush=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    if DELIVERY == "push" and fixture() is None:
        serve_push(stop_flag)
    print(f"listening {key} pid={os.getpid()}", file=sys.stderr, flush=True)
    try:
        while True:
            with State() as data:
                stopping = bool(data["control"].get("stop"))
                cursor = int(data["cursors"].get(key, 0))
            if stopping or stop_flag.get("requested"):
                stop()
            try:
                events = fetch_events(cursor)
            except NotImplementedError as exc:
                print(f"not implemented: {exc}", file=sys.stderr, flush=True)
                events = []
            with State() as data:
                for event in events:
                    text = str(event.get("text", ""))
                    if matches(text, filt):
                        conversation = str(event.get("conversation") or source)
                        alias = alias_for(data, conversation)
                        data["last"][alias] = {"id": event.get("id"), "sender": event.get("sender"),
                                               "conversation": conversation}
                        # D1 rule 2: exactly one `c<n> <sender>: <text>` line per
                        # message — a multi-line text is flattened and a sender
                        # never carries the `:` that ends the sender slot.
                        wire_text = " ".join(text.split())
                        sender = " ".join(str(event.get("sender") or "someone").replace(":", " ").split()) or "someone"
                        print(f"{alias} {sender}: {wire_text}", flush=True)
                data["cursors"][key] = cursor + len(events)
            time.sleep(POLL_S)
    finally:
        lock.unlink(missing_ok=True)
        # How this listener ends: `stop()` exits 0, anything else that gets
        # out of the loop is a failure (an uncaught error exits 1).
        exc = sys.exc_info()[1]
        code = 1
        if isinstance(exc, SystemExit):
            code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
        note_listener_end(lock, source, filt, code)


def cmd_reply(args: argparse.Namespace) -> None:
    text = args.text if args.text not in (None, "-") else sys.stdin.read().rstrip("\n")
    with State() as data:
        conversation = conversation_for(data, args.to)
        if conversation is None:
            emit({"outcome": "unknown_lane", "connector": CONNECTOR_ID, "to": args.to}, 2)
        key = args.key or f"{conversation}:{hashlib.sha1(text.encode()).hexdigest()[:12]}"
        for sent in data["outbound"]:
            if sent.get("key") == key:
                # Rule 3: the key posts at most once. A finished record is the
                # receipt; a `pending` one is another caller mid-post.
                emit(dict(sent, idempotent=True) if sent.get("outcome") == "sent"
                     else {"outcome": "in_flight", "connector": CONNECTOR_ID, "to": args.to, "key": key,
                           "idempotent": True, "hint": "another reply with this key is posting; retry the SAME key"})
        # Reserve BEFORE the visible post (ADR 23499 D7 shape): an overlapping
        # caller with the same key sees the reservation and posts nothing.
        message_id = f"m{len(data['outbound']) + 1}"
        data["outbound"].append({"outcome": "pending", "connector": CONNECTOR_ID, "to": args.to,
                                 "conversation": conversation, "message_id": message_id, "key": key})
    try:
        detail = send_reply(conversation, text)
    except BaseException as exc:  # noqa: BLE001 — release the reservation so a retry can post
        with State() as data:
            data["outbound"] = [r for r in data["outbound"] if not (r.get("key") == key and r.get("outcome") == "pending")]
        if isinstance(exc, NotImplementedError):
            emit({"outcome": "not_implemented", "connector": CONNECTOR_ID, "to": args.to, "detail": str(exc)}, 1)
        if isinstance(exc, (KeyboardInterrupt, SystemExit)):
            raise
        emit({"outcome": "failed", "connector": CONNECTOR_ID, "to": args.to, "detail": str(exc)}, 1)
    with State() as data:
        receipt = {"outcome": "sent", "connector": CONNECTOR_ID, "to": args.to, "conversation": conversation,
                   "message_id": message_id, "key": key, "origin": args.origin, "detail": detail}
        data["outbound"] = [receipt if (r.get("key") == key and r.get("outcome") == "pending") else r
                            for r in data["outbound"]]
    emit(receipt)


def cmd_describe(args: argparse.Namespace) -> None:
    with State() as data:
        conversation = conversation_for(data, args.to)
        if conversation is None:
            emit({"outcome": "unknown_lane", "connector": CONNECTOR_ID, "to": args.to}, 2)
        last = data["last"].get(args.to, {})
    emit({"connector": CONNECTOR_ID, "alias": args.to, "source": SOURCE, "conversation": conversation,
          "last_sender": last.get("sender"), "last_id": last.get("id"), **describe_conversation(conversation)})


def cmd_status(_args: argparse.Namespace) -> None:
    # The daemon's `start` reads `sources_available` to judge a recorded row
    # (a source word missing from it is `stale`, never armed) and matches the
    # row's words against `listeners` records by name: one record per source
    # word, beside one per live subscription key `<source>|<filter>`.
    listeners: dict = {word: {"listener": "absent", "pid": None, "subscriptions": []} for word in SOURCES_AVAILABLE}
    for record in live_listeners():
        key = f"{record['source']}|{record['filter']}"
        listeners[key] = {"listener": "live", "pid": record["pid"]}
        by_source = listeners.setdefault(record["source"], {"listener": "absent", "pid": None, "subscriptions": []})
        by_source.update(listener="live", pid=by_source["pid"] or record["pid"])
        by_source["subscriptions"].append(key)
    # A key whose last listener ended non-zero and has no live one carries
    # `exit` and `ended_at`; its source record carries the newest such end
    # while nothing is live on that source (the daemon's `start` records it).
    for record in ended_listeners():
        key = f"{record['source']}|{record['filter']}"
        if key in listeners:
            continue
        end = {"exit": record["exit"], "ended_at": record["ended_at"]}
        listeners[key] = {"listener": "absent", "pid": None, **end}
        by_source = listeners.setdefault(record["source"], {"listener": "absent", "pid": None, "subscriptions": []})
        if by_source["listener"] == "absent" and record["ended_at"] >= by_source.get("ended_at", ""):
            by_source.update(end)
    emit({"connector": CONNECTOR_ID, "delivery": DELIVERY, "source": SOURCE, "sources_available": list(SOURCES_AVAILABLE),
          "listeners": listeners, "reference": None, "env_pass": list(ENV_PASS),
          "capabilities": {CONNECTOR_ID: {"cards": False, "attach": False, "edit": False}}})


def cmd_disconnect(_args: argparse.Namespace) -> None:
    with State() as data:
        data["control"]["stop"] = True
    emit({"outcome": "stopping", "connector": CONNECTOR_ID})


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="{{SCRIPT_NAME}}")
    sub = parser.add_subparsers(dest="command", required=True)
    listen = sub.add_parser("listen")
    listen.add_argument("--source", default=None, help=f"default {SOURCE}")
    listen.add_argument("--filter", default=None, help=f"one word; default {DEFAULT_FILTER!r} (addressed to me); '' for everything")
    listen.set_defaults(func=cmd_listen)
    reply = sub.add_parser("reply")
    reply.add_argument("--to", required=True)
    reply.add_argument("--text", default=None, help="the text, or - for stdin")
    reply.add_argument("--key", default=None)
    reply.add_argument("--origin", default=None, help="<connector>/<conversation> this message was produced from")
    reply.set_defaults(func=cmd_reply)
    describe = sub.add_parser("describe")
    describe.add_argument("--to", required=True)
    describe.set_defaults(func=cmd_describe)
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)
    disconnect = sub.add_parser("disconnect")
    disconnect.set_defaults(func=cmd_disconnect)
    return parser


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
