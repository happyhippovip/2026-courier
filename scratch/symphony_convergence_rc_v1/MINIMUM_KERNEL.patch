+console.log('================================================================');
+console.log(' MONEY FACTORY ADVERSARIAL TEST SUITE');
+console.log('================================================================\n');
+
+let passed = 0;
+let failed = 0;
+const results = [];
+
+function runTest(testId, description, fn) {
+  try {
+    fn();
+    passed++;
+    results.push({ testId, description, status: 'PASS' });
+    console.log(`[PASS] ${testId}: ${description}`);
+  } catch (err) {
