<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.courier.mac_worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>TARGET_DIR/venv/bin/python</string>
        <string>TARGET_DIR/scripts/mac_worker/daemon.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>TARGET_DIR</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>TARGET_DIR/scripts/mac_worker/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>TARGET_DIR/scripts/mac_worker/logs/launchd.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/user/.local/bin</string>
    </dict>
</dict>
</plist>
