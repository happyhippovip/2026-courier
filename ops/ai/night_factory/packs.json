{"cannon_rule":"ONE GOAL -> independent fan-out -> parallel results -> barrier -> Writer Brief -> ONE Writer -> verification -> coherent result. Reject parallelism that is duplicate work.","customer_packs":{"BEGINNER_PACK":["thought-inbox","thought-to-new-project","thought-to-goal","idea-to-prototype"],"DENNIS_DAILY_PACK":["thought-inbox","morning-review","night-work"],"DEVELOPER_PACK":["bug-e2e","ci-red-build","github-review","documentation","release-prep"],"FOUNDER_PACK":["thought-inbox","customer-pilot","product-demo","release-prep"],"GITHUB_PACK":["github-review","ci-red-build","documentation"],"MUSE_PACK":["thought-dedup","deep-research","competitor-research","morning-review"],"RESEARCH_PACK":["deep-research","competitor-research","documentation"]},"recipes":[{"barrier":"all tracks cited","brief":"answer + gaps","fan_out":["docs track","web track","memory track"],"goal":"answer hard question with sources","id":"C01-deep-answer","verify":"every claim sourced","writer":"muse-research"},{"barrier":"same failing input","brief":"minimal repro + fix","fan_out":["repro script","log bisect","twin env"],"goal":"kill flaky test","id":"C02-flaky-kill","verify":"10x green","writer":"assigned-dev"},{"barrier":"all routes probed","brief":" findings with file:line","fan_out":["scope A paths","scope B paths","secret scan"],"goal":"bounded security pass","id":"C03-scope-scan","verify":"zero out-of-scope writes","writer":"assigned-reviewer"},{"barrier":"shared audit schema","brief":"coherent report","fan_out":["surface A","surface B","surface C"],"goal":"pilot audit, 3 surfaces","id":"C04-pilot-3x","verify":"re-run stable","writer":"assigned-dev"},{"barrier":"common rubric","brief":"ranked list","fan_out":["candidate 1","candidate 2","candidate 3"],"goal":"pick tool/vendor","id":"C05-vendor-pick","verify":"rubric scored","writer":"founder"},{"barrier":"merged notes","brief":"TAKEOVER.md","fan_out":["build","test","deploy-dry"],"goal":"take over repo in one night","id":"C06-takeo