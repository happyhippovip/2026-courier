+def test_tree_alive_windows_running_means_poll_is_none(monkeypatch):
+    """Windows has no process groups: poll() is the liveness probe.
+
+    os.name is patched so this pins the nt branch on every platform
+    instead of skipping the Windows safety requirement elsewhere.
+    """
+    monkeypatch.setattr(os, "name", "nt")
+    assert ContainedRun(_FakeProc(pid=4242, poll_result=None), None, "o", "e").tree_alive() is True
+
+
+def test_tree_alive_windows_exited_means_poll_is_set(monkeypatch):
+    monkeypatch.setattr(os, "name", "nt")
+    assert ContainedRun(_FakeProc(pid=4242, poll_result=3), None, "o", "e").tree_alive() is False
+
