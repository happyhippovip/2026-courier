{
  "schema_version": "2.0",
  "policy_title": "Courier Multi-Agent & Teamwork Routing Policy",
  "updated_at": "2026-08-30T14:46:00Z",
  "rules": {
    "routine_tasks": {
      "mode": "SINGLE_BOUNDED_AGENT",
      "description": "Routine deterministic operations must run via a single bounded agent to conserve token budget and execution overhead.",
      "applicable_categories": [
        "deterministic_render",
        "schema_validation",
        "file_hash_audit",
        "routine_sync",
        "task_queue_routing"
      ]
    },
    "teamwork_tasks": {
      "mode": "MULTI_AGENT_TEAMWORK",
      "description": "Teamwork with candidate/critic subagents is reserved for high-leverage qualitative workflows where multiple viewpoints materially improve output.",
      "applicable_categories": [
        "architecture_design",
        "complex_debugging",
        "visual_qa_critique",
        "content_pipeline_optimization",
        "high_risk_policy_review"
      ],
      "critic_roles": [
        "flutter_a11y_agent",
        "research",
        "visual_qa_critic"
      ]
    }
  },
  "safety_boundaries": {
    "cost_policy": "ZERO_COST_ONLY",
    "human_gate_policy": "STOP_ON_HUMAN_GATE_ONLY",
    "render_policy": "BOUNDED_ONLY_NO_UNBOUNDED_MOVIE_MAKER",
    "secrets_policy": "NEVER_LOG_OR_STORE_CREDENTIALS"
  }
}
