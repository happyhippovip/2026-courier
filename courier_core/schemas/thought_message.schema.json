{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Channel-neutral thought intake message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "timestamp", "source", "payload", "payload_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "thought-message-1.0"},
    "message_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "enum": ["CHAT_EXPORT", "COURIER_EVENT", "WORK_RESULT", "GOOGLE_ANTIGRAVITY_RESULT", "SLACK"]},
    "payload": {"type": "object"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
