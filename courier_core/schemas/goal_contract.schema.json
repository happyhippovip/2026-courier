{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/goal_contract.schema.json",
  "title": "Goal Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "end_result",
    "allowed_scope",
    "forbidden_scope",
    "constraints",
    "acceptance_criteria",
    "side_effect_limits",
    "gates",
    "confirmations"
  ],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "end_result": {"type": "string", "minLength": 1},
    "allowed_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "evidence_class"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "evidence_class": {"type": "string", "minLength": 1}
        }
      }
    },
    "side_effect_limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "money", "safety"],
      "properties": {
        "human": {"type": "boolean"},
        "money": {"type": "boolean"},
        "safety": {"type": "boolean"}
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_kind", "actor_ref", "at"],
        "properties": {
          "actor_kind": {"const": "human"},
          "actor_ref": {"type": "string", "minLength": 1},
          "at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
