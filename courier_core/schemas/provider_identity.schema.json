{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/provider_identity.schema.json",
  "title": "Provider identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "provider_kind",
    "version",
    "version_source",
    "binary_fingerprint",
    "captured_at"
  ],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "provider_kind": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 4096},
    "version_source": {"enum": ["cli_reported", "config", "unknown"]},
    "binary_fingerprint": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
