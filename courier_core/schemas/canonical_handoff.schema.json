{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/canonical_handoff.schema.json",
  "title": "Courier Canonical Handoff",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "goal_satisfied",
    "regression_pass",
    "product_tests_pass",
    "courier_tests_pass",
    "single_writer_preserved",
    "human_gate_required",
    "active_work_at_end",
    "unresolved_blocker",
    "manual_state_surgery_used",
    "direct_bypass_used",
    "ready_for_next_goal"
  ],
  "properties": {
    "goal_satisfied": {"type": "string", "enum": ["YES", "NO"]},
    "regression_pass": {"type": "string", "enum": ["YES", "NO"]},
    "product_tests_pass": {"type": "string", "enum": ["YES", "NO"]},
    "courier_tests_pass": {"type": "string", "enum": ["YES", "NO"]},
    "single_writer_preserved": {"type": "string", "enum": ["YES", "NO"]},
    "human_gate_required": {"type": "string", "enum": ["YES", "NO"]},
    "active_work_at_end": {"type": "string", "minLength": 1},
    "unresolved_blocker": {"type": "string", "minLength": 1},
    "manual_state_surgery_used": {"type": "string", "enum": ["YES", "NO"]},
    "direct_bypass_used": {"type": "string", "enum": ["YES", "NO"]},
    "ready_for_next_goal": {"type": "string", "enum": ["YES", "NO"]},
    "ending_fingerprint": {"type": ["string", "null"]},
    "product_test_count": {"type": ["integer", "null"], "minimum": 0},
    "courier_test_count": {"type": ["integer", "null"], "minimum": 0},
    "verified_goal_id": {"type": ["string", "null"]},
    "last_verified_mission_id": {"type": ["string", "null"]},
    "last_verified_task_hash": {"type": ["string", "null"]},
    "timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "current_goal": {"type": ["string", "null"]},
    "next_safe_action": {"type": ["string", "null"]}
  }
}
