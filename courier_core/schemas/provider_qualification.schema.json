{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/provider_qualification.schema.json",
  "title": "Provider qualification store",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "config_hash",
          "probe_results",
          "recorded_at",
          "status"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "version": {"type": "string", "minLength": 1, "maxLength": 4096},
          "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "probe_results": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["probe_id", "passed", "evidence"],
              "properties": {
                "probe_id": {"type": "string", "minLength": 1, "maxLength": 200},
                "passed": {"type": "boolean"},
                "evidence": {"type": "string", "minLength": 1, "maxLength": 1024}
              }
            }
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "status": {"enum": ["QUALIFIED", "UNQUALIFIED", "STALE"]}
        }
      }
    }
  }
}
