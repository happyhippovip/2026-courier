{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyhippovip/2026-courier/schemas/provider_invalidation.schema.json",
  "title": "Provider invalidation log",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_name",
          "old_fingerprint",
          "new_fingerprint",
          "reason",
          "recorded_at"
        ],
        "properties": {
          "provider_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "old_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "new_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"enum": ["version", "binary", "profile", "identity"]},
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          }
        }
      }
    }
  }
}
