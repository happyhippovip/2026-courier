{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thought Coverage Ledger",
  "description": "Persistent checkpoint and coverage metadata; it never contains credentials or original secret-bearing payloads.",
  "type": "object",
  "required": ["schema_version", "initial_anchor", "earliest_available_message", "latest_available_message", "scanner_ranges", "completed_checkpoints", "gaps", "overlaps", "message_counts", "processed_messages"],
  "properties": {
    "schema_version": {"type": "string", "const": "thought-coverage-ledger-1.0"},
    "initial_anchor": {"type": "string", "format": "date"},
    "earliest_available_message": {"type": ["object", "null"]},
    "latest_available_message": {"type": ["object", "null"]},
    "scanner_ranges": {"type": "object"},
    "completed_checkpoints": {"type": "object"},
    "gaps": {"type": "array"},
    "overlaps": {"type": "array"},
    "message_counts": {"type": "object"},
    "processed_messages": {"type": "object"}
  }
}
