{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstallStatus",
  "description": "Hub-facing installation status. Derived only from recorded evidence. No secret fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "version", "reason_code", "checked_at", "worker_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "state": {
      "type": "string",
      "enum": [
        "NOT_INSTALLED",
        "INSTALLING",
        "INSTALLED_UNVERIFIED",
        "HEALTHY",
        "REPAIR_REQUIRED",
        "FAILED"
      ]
    },
    "version": {"type": ["string", "null"]},
    "reason_code": {"type": ["string", "null"]},
    "checked_at": {"type": "string", "minLength": 1},
    "worker_id": {"type": ["string", "null"]}
  }
}
