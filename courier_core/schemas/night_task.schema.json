{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NightTask",
  "description": "Persistent task record for the Autonomous Night Supervisor Queue (093)",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "priority",
    "instruction",
    "project",
    "status",
    "created_at",
    "attempt_count",
    "max_attempts",
    "requires_human"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Task priority where 0 is highest priority (P0)"
    },
    "instruction": {
      "type": "string",
      "minLength": 3
    },
    "project": {
      "type": "string",
      "enum": [
        "2026-courier",
        "2026-project-memory",
        "FruitKI-YouTube",
        "3D-KI-TikTok"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "HUMAN_GATE",
        "BLOCKED",
        "FAILED_RETRYABLE",
        "FAILED_FINAL"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_human": {
      "type": "boolean"
    },
    "last_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost_policy": {
      "type": "string",
      "const": "ZERO_COST_ONLY"
    },
    "human_gate_policy": {
      "type": "string",
      "const": "STOP_ON_HUMAN_GATE_ONLY"
    },
    "target_agent": {
      "type": "string",
      "default": "ANTIGRAVITY"
    }
  }
}
