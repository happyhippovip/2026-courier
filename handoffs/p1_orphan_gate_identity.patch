+# -- L3-orphan-gate-pid-identity (P1): owner identity, not bare PID -------------
+
+
+def test_orphan_gate_reaps_pid_reused_owner_record(tmp_path):
+    """A live PID with the wrong create_time is NOT the owner: reap it.
+
+    Simulates PID reuse deterministically: owner_pid is this very test
+    process (guaranteed live on every platform) but the recorded create_time
+    belongs to a dead older instance. Portable: no signals, no sleeps.
+    """
+    import psutil
+
+    me = psutil.Process()
+    record = {"task_id": "t", "attempt": 1, "dispatch_id": "reuse-1", "worker_id": "w",
+              "owner_pid": me.pid, "owner_create_time": me.create_time() + 3600.0,
+              "child_pid": 0, "pgid": None}
+    claims = tmp_path / "run" / "claims"
+    claims.mkdir(parents=True)
+    (claims / "dispatch-reuse-1.json").write_text(json.dumps(record), encoding="utf-8")
+    assert H.run_orphan_gate(str(tmp_path)) == 1
+    assert list(claims.glob("*.json")) == []
+
+
+def test_orphan_gate_keeps_live_owner_record(tmp_path):
+    """A live PID with the matching create_time IS the owner: hands off."""
+    import psutil
+
+    me = psutil.Process()
+    record = {"task_id": "t", "attempt": 1, "dispatch_id": "live-1", "worker_id": "w",
+              "owner_pid": me.pid, "owner_create_time": me.create_time(),
+              "child_pid": 0, "pgid": None}
+    claims = tmp_path / "run" / "claims"
+    claims.mkdir(parents=True)
+    target = claims / "dispatch-live-1.json"
+    target.write_text(json.dumps(record), encoding="utf-8")
+    assert H.run_orphan_gate(str(tmp_path)) == 0
+    assert target.exists()
+
+
+def test_orphan_gate_reaps_legacy_record_without_create_time(tmp_path):
+    """Legacy records (no owner_create_time) are never proof of liveness."""
+    record = {"task_id": "t", "attempt": 1, "dispatch_id": "legacy-1", "worker_id": "w",
+              "owner_pid": 2 ** 30, "child_pid": 0, "pgid": None}
+    claims = tmp_path / "run" / "claims"
+    claims.mkdir(parents=True)
+    (claims / "dispatch-legacy-1.json").write_text(json.dumps(record), encoding="utf-8")
+    assert H.run_orphan_gate(str(tmp_path)) == 1
+    assert list(claims.glob("*.json")) == []
