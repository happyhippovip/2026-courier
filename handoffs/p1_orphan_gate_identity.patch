+def _process_create_time(pid: int) -> Optional[float]:
+    """Creation time of ``pid``, or None when it cannot be proven.
+
+    None covers: no such process, access denied, zombie (dead but unreaped),
+    and any psutil failure. Callers treat None as "not the recorded owner".
+    """
+    try:
+        proc = psutil.Process(pid)
+        if proc.status() == psutil.STATUS_ZOMBIE:
+            return None
+        return float(proc.create_time())
+    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess,
+            OSError, ValueError):
+        return None
+
+
+def _owner_matches(owner_pid: int, owner_create_time) -> bool:
+    """True only if ``owner_pid`` is alive AND is the recorded instance.
+
+    Identity is (pid, create_time) within OWNER_CREATE_TIME_TOLERANCE_S,
+    mirroring courier_runtime.ownership. Legacy records without create_time,
+    unreadable times, and recycled PIDs are never proof of liveness, so the
+    orphan gate reaps them instead of skipping them.
+    """
+    if owner_pid <= 0:
+        return False
+    if owner_create_time is None:
+        return False
+    try:
+        recorded = float(owner_create_time)
+    except (TypeError, ValueError):
+        return False
+    live = _process_create_time(owner_pid)
+    if live is None:
+        return False
+    return abs(live - recorded) <= OWNER_CREATE_TIME_TOLERANCE_S
+
