+        return "params.estimated_cost_eur must be a finite number >= 0"
+    if cost > SPEND_LIMIT_EUR:
+        return f"params.estimated_cost_eur {cost} is over the spend limit of {SPEND_LIMIT_EUR} EUR"
+    return None
