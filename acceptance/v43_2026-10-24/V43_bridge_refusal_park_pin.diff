+"""V43: a mission the controller refuses for good is parked, not re-posted on every pass.
+
+With the controller cost gate (F-C1, PR #846) the bridge's own spend gate and the
+controller can disagree (an adapter without a declared cost class, a marker the bridge
+does not read). The controller then answers 400 ``cost_blocked``. Today the bridge only
+reports ``rejected``: the mission stays unposted, is posted again on every pass, never
+gets a BLOCKED status, and the work queue (WQ-1b ``park``) cannot free its holder.
+"""
+import json
+
+import pytest
+
+from tests.test_ledger_v1_bridge import FakeHTTP, _home, _ready, _run, _seed, _spec
+
+
+class RefusingHTTP(FakeHTTP):
+    def __call__(self, method, url, headers, body, timeout):
+        if method == "POST" and url.endswith("/v1/tasks"):
+            self.posts.append(json.loads(body.decode("utf-8")))
+            return 400, b'{"error":"cost_blocked","message":"the adapter declares no cost class"}'
+        return super().__call__(method, url, headers, body, timeout)
+
+
+@pytest.mark.xfail(strict=True, raises=AssertionError,
+                   reason="bridge re-posts a 4xx-refused mission forever (owner: ledger_v1_bridge)")
+def test_a_cost_blocked_refusal_parks_the_mission_and_is_not_posted_again(tmp_path):
+    http = RefusingHTTP()
+    home = _home(tmp_path, {"A": _spec(adapter="telegram_delivery")})
+    _seed(home, [_ready("A", "a-assign")])
+    for _ in range(3):
+        _run(home, http)
+    mission = json.loads((home / "ledger_bridge_state.json").read_text(encoding="utf-8"))["missions"]["A"]
+    assert len(http.posts) == 1                       # refused once, not on every pass
+    assert mission.get("status") == "BLOCKED"         # the queue can park it (WQ-1b) and a human decides
