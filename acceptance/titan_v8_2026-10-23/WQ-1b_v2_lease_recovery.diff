+    queue.claim("WKA", "holder-b", 60, now=LATER + timedelta(seconds=10), announce=True)   # B dies before ATTACH
+    back = LATER + timedelta(seconds=100)
+    assert feed_once(a, "GOOGLE_WINDOWS", "WINDOWS_REMOTE", now=back)["claimed"] == ["WKA"]
