+_PROVIDER_CLIS = ("cursor-agent", "claude-code", "antigravity", "chatgpt", "copilot", "gemini", "openai",
+                  "claude", "codex", "aider", "grok", "agy")
+_PROVIDER_WORD = re.compile(r"(?<![A-Za-z0-9_.-])(?:@[a-z0-9-]+/)?(" + "|".join(_PROVIDER_CLIS)
+                            + r")(?:\.(?:exe|cmd|bat|ps1))?(?![A-Za-z0-9_-])", re.IGNORECASE)
+_CREDENTIAL_WORDS = ("KEY", "TOKEN", "SECRET", "PASSWORD", "PASSWD", "COOKIE", "CREDENTIAL", "AUTH")
+
+
+def _provider_cli_in(instruction):
+    match = _PROVIDER_WORD.search(str(instruction or ""))
+    return match.group(1).lower() if match else None
+
+
+def _child_env():
+    """The worker's environment without anything that authenticates (server key, provider keys)."""
+    return {name: value for name, value in os.environ.items()
+            if not any(word in name.upper() for word in _CREDENTIAL_WORDS)}
+
