+# What a command needs from the host to start and find its tools; nothing that
+# authenticates. Everything else in the worker's environment (provider keys,
+# controller token, cloud credentials) stays out of the child.
+INHERITED_ENV = frozenset({
+    "PATH", "PATHEXT", "SYSTEMROOT", "SYSTEMDRIVE", "WINDIR", "COMSPEC", "TEMP", "TMP", "TMPDIR",
+    "HOME", "USERPROFILE", "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE", "TZ", "PYTHONIOENCODING",
+    "PYTHONUTF8", "NUMBER_OF_PROCESSORS", "PROCESSOR_ARCHITECTURE",
+})
+PROTECTED_ENV = frozenset({
+    "HOME", "USERPROFILE", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "APPDATA", "LOCALAPPDATA",
+    "PATH", "PATHEXT", "COMSPEC", "SYSTEMROOT", "PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP",
+    "LD_PRELOAD", "LD_LIBRARY_PATH", "DYLD_INSERT_LIBRARIES", "DYLD_LIBRARY_PATH", "NODE_OPTIONS",
+    "BASH_ENV", "ENV", "PERL5OPT", "RUBYOPT",
+})
+_CREDENTIAL_WORDS = ("KEY", "TOKEN", "SECRET", "PASSWORD", "PASSWD", "COOKIE", "CREDENTIAL", "AUTH")
+
+
+# Provider CLIs that spend a (possibly included, never verified) quota. local_shell is a
+# metered adapter, and a task's own 0.0 estimate is not proof that a provider run is free,
+# so these are refused outright: the command itself, after a wrapper (env, npx, timeout ...),
+# or named as a word in an inline script (sh -c, cmd /c, powershell -Command, python -c ...).
+# This is a tripwire, not a sandbox: the child also gets its own empty home folder.
+PROVIDER_CLIS = frozenset({
+    "codex", "claude", "claude-code", "gemini", "agy", "antigravity", "grok", "cursor-agent",
+    "openai", "aider", "chatgpt", "copilot",
+})
+_WRAPPERS = frozenset({"env", "npx", "bunx", "pnpx", "uvx", "pipx", "timeout", "nice", "nohup", "xargs",
+                       "sudo", "doas", "stdbuf", "time", "exec", "start", "call"})
+_INLINE_FLAGS = frozenset({"-c", "-lc", "-ic", "/c", "/k", "-command", "-e", "--eval", "-encodedcommand", "-r"})
+_SHELLS_AND_INTERPRETERS = frozenset({"sh", "bash", "zsh", "dash", "ksh", "fish", "cmd", "powershell", "pwsh",
+                                      "python", "python3", "py", "node", "deno", "bun", "perl", "ruby", "php"})
+_PROVIDER_WORD = re.compile(r"(?<![A-Za-z0-9_.-])(?:@[a-z0-9-]+/)?(" + "|".join(
+    sorted((re.escape(n) for n in PROVIDER_CLIS), key=len, reverse=True)) + r")(?:\.(?:exe|cmd|bat|ps1))?(?![A-Za-z0-9_-])",
+    re.IGNORECASE)
+
+
+def _program(token: str) -> str:
+    name = token.replace("\\", "/").rsplit("/", 1)[-1].lower()
+    for ext in (".exe", ".cmd", ".bat", ".ps1"):
+        if name.endswith(ext):
+            return name[: -len(ext)]
+    return name
+
+
+def _provider_in_argv(command: Sequence[str]) -> str | None:
+    """The provider CLI an argv would start, or None."""
+    i = 0
+    while i < len(command):
+        prog = _program(command[i])
+        if prog in PROVIDER_CLIS:
+            return prog
+        if prog.startswith("python") or prog in _SHELLS_AND_INTERPRETERS:
+            for j in range(i + 1, len(command) - 1):
+                if command[j].lower() in _INLINE_FLAGS:
+                    match = _PROVIDER_WORD.search(" ".join(command[j + 1:]))
+                    return match.group(1).lower() if match else None
+            return None
+        if prog in _WRAPPERS:
+            i += 1
+            while i < len(command) and (command[i].startswith("-") or "=" in command[i] or command[i].isdigit()):
+                i += 1
+            if i < len(command):
+                package = command[i].lower()
+                if package.startswith("@") and "/" in package:   # npx @scope/name
+                    match = _PROVIDER_WORD.search(package)
+                    if match:
+                        return match.group(1).lower()
+            continue
+        return None
+    return None
+
+
+def _is_credential_name(name: str) -> bool:
+    upper = name.upper()
+    return any(word in upper for word in _CREDENTIAL_WORDS)
+
+
+HOME_ENV = ("HOME", "USERPROFILE", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "APPDATA", "LOCALAPPDATA")
+
+
+def _child_env(extra: Mapping[str, str], home: Path | None = None) -> dict:
+    env = {}
+    for name, value in os.environ.items():
+        if name.upper() in INHERITED_ENV and not _is_credential_name(name) and name.upper() not in HOME_ENV:
+            env[name] = value
+    if home is not None:
+        # An empty home of its own: CLI logins in the worker's home (~/.codex, ~/.claude,
+        # ~/.gemini, %APPDATA%) are not found by the child.
+        for name in HOME_ENV:
+            env[name] = str(home)
+    env.update(extra)
+    return env
+
+
