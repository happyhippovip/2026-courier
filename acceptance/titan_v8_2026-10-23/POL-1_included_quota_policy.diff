+def _unpriced_reason(entry) -> str | None:
+    """None when the policy entry proves a run costs 0 EUR, else the blocking reason."""
+    if not isinstance(entry, dict) or entry.get("status") != "ACTIVE_PAID":
+        return "RESOURCE_NOT_ACTIVE"
+    mode = entry.get("billing_mode")
+    if mode == "LOCAL":
+        return None
+    if mode != "INCLUDED_QUOTA":
+        return "BILLING_MODE_UNKNOWN"
+    cost = entry.get("effective_cost_eur")
+    known_zero = (not isinstance(cost, bool) and isinstance(cost, (int, float)) and math.isfinite(cost)
+                  and cost == 0)
+    if not known_zero or entry.get("cost_source") != "PROVIDER_VERIFIED":
+        return "INCLUDED_QUOTA_UNVERIFIED"
+    return None
+
+
