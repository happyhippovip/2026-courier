+    calls = _capture_popen(daemon, monkeypatch)
+    res = daemon.run_task({"task_id": "win-a", "instruction": instruction, "estimated_cost_eur": 0.0},
+                          {"WORKER_ID": "WIN-01"})
+    assert res["status"] == "SUCCESS" and len(calls) == 1
+
