+# Adapters that can charge per run. They must state a finite estimate before a task exists.
+PAID_ADAPTERS = frozenset({"provider_exec"})
+
+
+def cost_admission(adapter: str, params: dict) -> str | None:
+    """None if the task may be created, else why not. UNKNOWN_COST blocks before the journal.
+
+    An explicit unknown marker or an invalid estimate blocks for every adapter."""
+    if params.get("unknown_cost") is True or params.get("cost_class") == "unknown":
+        return "task is marked as unknown cost"
+    if adapter not in PAID_ADAPTERS and "estimated_cost_eur" not in params:
+        return None
+    cost = params.get("estimated_cost_eur")
+    if isinstance(cost, bool) or not isinstance(cost, (int, float)) or not math.isfinite(cost) or cost < 0:
+        return f"adapter {adapter!r} needs a finite, non-negative params.estimated_cost_eur"
+    return None
+
+
