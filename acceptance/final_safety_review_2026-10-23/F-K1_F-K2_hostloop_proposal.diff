diff --git a/tests/test_host_loop_proof.py b/tests/test_host_loop_proof.py
new file mode 100644
index 000000000..a6ea1817d
--- /dev/null
+++ b/tests/test_host_loop_proof.py
@@ -0,0 +1,79 @@
+"""F-K1/F-K2 proposal for L3: a provider DONE line is a claim; DONE needs journal proof."""
+import json
+
+from courier_runtime.continuity import CLAIMED, DONE, Kirby
+from courier_runtime.provider_events import handle
+
+
+def campaign(tmp_path):
+    k = Kirby(tmp_path / "kirby.json", "host-a")
+    k.add_workkeys(["WK-1", "WK-2"])
+    k.open_slot("S1", "local")
+    k.wake("S1")
+    k.deliver("S1")
+    return k
+
+
+def test_done_line_without_a_prover_does_not_complete(tmp_path):
+    k = campaign(tmp_path)
+    assert handle(k, "S1", "TURN_ENDED outcome=DONE checkpoint=trust me") == "NOT_PROVEN"
+    assert k.workkeys["WK-1"].state == CLAIMED
+    assert k.workkeys["WK-1"].checkpoint == "trust me"
+    assert not (tmp_path / "receipts.jsonl").exists()
+
+
+def test_done_line_with_a_prover_that_finds_no_proof_does_not_complete(tmp_path):
+    k = campaign(tmp_path)
+    assert handle(k, "S1", "TURN_ENDED outcome=DONE", prove=lambda workkey: None) == "NOT_PROVEN"
+    assert k.workkeys["WK-1"].state == CLAIMED
+
+
+def test_done_line_with_journal_proof_completes_and_records_the_proof(tmp_path):
+    k = campaign(tmp_path)
+    seen = []
+
+    def prove(workkey):
+        seen.append(workkey)
+        return "journal:9:RESULT_ACCEPTED"
+    handle(k, "S1", "TURN_ENDED outcome=DONE checkpoint=cp", prove=prove)
+    assert seen == ["WK-1"]
+    assert k.workkeys["WK-1"].state == DONE
+    assert k.workkeys["WK-1"].checkpoint == "cp | journal:9:RESULT_ACCEPTED"
+    receipt = json.loads((tmp_path / "receipts.jsonl").read_text().splitlines()[-1])
+    assert "journal:9:RESULT_ACCEPTED" in receipt["checkpoint"]
+
+
+def test_blocked_and_failed_lines_still_park_without_proof(tmp_path):
+    k = campaign(tmp_path)
+    handle(k, "S1", "TURN_ENDED outcome=BLOCKED reason=needs a human")
+    assert k.workkeys["WK-1"].state == "BLOCKED"
+
+
+def test_host_loop_main_rereads_the_campaign_under_the_engine_lock_each_round(tmp_path, monkeypatch):
+    from courier_runtime import host_loop
+    from courier_runtime.ledger_engine import LedgerEngine
+    state = tmp_path / "campaign" / "kirby.json"
+    engine = LedgerEngine(None, state, "host-a")
+    engine.add_workkeys(["WK-1"])
+    engine.open_slot("S1", "local")
+    signals = tmp_path / "signals.log"
+    signals.write_text("")
+    rounds = []
+
+    def fake_run_once(kirby, slot, signal_path, st, **kw):
+        rounds.append(kirby)
+        return [], {}, []
+    monkeypatch.setattr(host_loop, "run_once", fake_run_once)
+    # Between two rounds (outside the loop's lock) the engine claims WK-1, as another process would.
+    monkeypatch.setattr(host_loop.time, "sleep", lambda s: engine.next("S1"))
+    calls = {"n": 0}
+    real_exclusive = host_loop._exclusive
+
+    def counting_exclusive(path):
+        calls["n"] += 1
+        return real_exclusive(path)
+    monkeypatch.setattr(host_loop, "_exclusive", counting_exclusive)
+    host_loop.main(["--state", str(state), "--slot", "S1", "--signals", str(signals), "--rounds", "2"])
+    assert calls["n"] == 2                       # one lock per round
+    assert rounds[0] is not rounds[1]            # a fresh Kirby per round
+    assert rounds[1].workkeys["WK-1"].state == CLAIMED   # sees the engine's write instead of overwriting it
