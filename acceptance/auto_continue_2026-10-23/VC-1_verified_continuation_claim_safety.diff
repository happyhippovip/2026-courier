+def _read_claim(path: Path) -> Optional[dict]:
+    """The claim as a dict with owner, pid, created_at_ts and ttl_s, or None if unreadable."""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    if not isinstance(data, dict) or not isinstance(data.get("owner"), str):
+        return None
+    if isinstance(data.get("pid"), bool) or not isinstance(data.get("pid"), int):
+        return None
+    for key in ("created_at_ts", "ttl_s"):
+        if isinstance(data.get(key), bool) or not isinstance(data.get(key), (int, float)):
+            return None
+    return data
+
+
