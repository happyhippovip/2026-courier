# Runtime envelopes remain local and are never committed automatically.
events/incoming/*.json
events/processed/*.json
events/dispatch/*.json
events/proposals/*.json
events/approvals/*.json
events/chief-decisions/*.json
events/night-queue/*.json
events/morning-reports/*.json
events/morning-reports/*.md
events/thought-incoming/*.json
events/thought-processed/*.json
events/thought-rejected/*.json
events/thoughts/*.json
events/agent-states/*.json

# Python & bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Runtime locks & leases
events/locks/*.lease
events/locks/*.lock

# Runtime GitHub Transport envelopes remain local.
events/transport/incoming/*.json
events/transport/processed/*.json
events/transport/rejected/*.json
events/transport/acknowledgements/*.json
events/transport/transitions/*.json
events/transport/transitions.jsonl
events/transport/claims/*.claim
events/transport/*.lock
events/transport/registry.json
!events/transport/.gitkeep
!events/transport/incoming/.gitkeep
!events/transport/processed/.gitkeep
!events/transport/rejected/.gitkeep
!events/transport/acknowledgements/.gitkeep
!events/transport/transitions/.gitkeep
!events/transport/claims/.gitkeep

# Runtime Review Ledger & Budget files remain local.
events/reviews/*.json
events/reviews/*.jsonl
events/reviews/*.lock
!events/reviews/.gitkeep

# Runtime state & sensitive payment configs remain strictly local
events/runtime-state/*.json
events/runtime-state/*.lock
events/task-envelopes/*.json
!events/runtime-state/.gitkeep
!events/task-envelopes/.gitkeep





# Demo workflow runs & scratch assets
events/demo/*
!events/demo/.gitkeep
studio/assets/*_cropped.*

# Intermediate context snapshot history (replicated in 2026-project-memory)
events/context-snapshots/snapshot-v*.json

# Runtime generated content artifacts remain local.
runtime/content/*
!runtime/content/.gitkeep

# Keep directory markers only.
!events/incoming/.gitkeep
!events/processed/.gitkeep
!events/dispatch/.gitkeep
!events/proposals/.gitkeep
!events/approvals/.gitkeep
!events/chief-decisions/.gitkeep
!events/night-queue/.gitkeep
!events/morning-reports/.gitkeep
!events/thought-incoming/.gitkeep
!events/thought-processed/.gitkeep
!events/thought-rejected/.gitkeep
!events/thoughts/.gitkeep
!events/agent-states/.gitkeep
!events/locks/.gitkeep
!events/context-snapshots/.gitkeep
!events/context-snapshots/snapshot-current.json
!events/academy/economics.json

# Mac worker runtime
scripts/mac_worker/config.json
scripts/mac_worker/logs/
scripts/mac_worker/state/
scripts/mac_worker/inbox/
scripts/mac_worker/outbox/
scripts/windows_worker/logs/
scripts/windows_worker/state/


# Local confidential strategy material — NEVER COMMIT.
private_strategy/
secret_notes/
confidential/

# Durable GitHub dispatch packets and adapter state (runtime only).
events/github-dispatch/

# Local credential files (never commit real keys).
.env
deploy/.env

# --- v1 integration (L1): build, test and runtime artifacts never belong in git ---
*.egg-info/
/build/
/dist/
.pytest_cache/
.venv/
/venv/
# Test pollution observed at e95aa787: some tests write into the working tree.
# Test owners must fix isolation; these entries only keep accidental commits out.
courier_canary_process_*.txt
server/state/artifacts/
# The v1 runtime home lives outside the repository (COURIER_HOME).
# Local journals and SQLite side files must never be committed.
courier.db
courier.db-wal
courier.db-shm
*.sqlite3-wal
*.sqlite3-shm

# --- v1 hygiene (L1 cycle 2): runtime state never lives in git; see docs/v1/INTEGRATION_LOG.md ---
/server/state/central_state.json
/server/state/central_state.json.sig
/logs/*
!/logs/.gitkeep
/runtime/resource_guard/
/runtime/harmless_staging_marker.json
/scripts/mac_worker/logs/
/scripts/windows_worker/courier_canary_*.txt
/work_dir/
/courier_canary_*.txt
# outputs legacy scripts and workflows write into the repo root (history copies in attic/)
/central_state.json
/dummy_task_2.json
/dummy_task_3.json
/founder_concierge_result.json
/gemini_result*.json
/task.json
/result.json
/verified.json
/handoff.json
/reconciliation.json
/agy_test_*.txt

# Owned-process registry written by local supervisors (courier_runtime.ownership).
/run/owned_processes.json

# Generated per-machine runtime state never belongs in git (Muse wall/supervisor,
# revenue-worker target clones, pytest temp dirs). tests/test_repo_hygiene.py guards this.
/runtime/muse-data/
/runtime/slots/
/runtime/win_slots/
/scripts/revenue_worker_state/
/.tmp_pytest/

# Outputs written by proof scripts and tests; generated, never tracked.
/server/state/test_state.json
/server/state/test_state.json.sig
/server/state/*.lock
/scripts/logs/

# PyInstaller rotates the previous bundle to dist_old_<ticks>; never commit it.
scripts/windows_worker/dist_old_*/
