# Runtime envelopes remain local and are never committed automatically.
events/incoming/*.json
events/processed/*.json
events/dispatch/*.json
events/proposals/*.json
events/approvals/*.json
events/chief-decisions/*.json
events/night-queue/*.json
events/morning-reports/*.json
events/morning-reports/*.md
events/thought-incoming/*.json
events/thought-processed/*.json
events/thought-rejected/*.json
events/thoughts/*.json
events/agent-states/*.json

# Python & bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Runtime locks & leases
events/locks/*.lease
events/locks/*.lock

# Demo workflow runs & scratch assets
events/demo/*
!events/demo/.gitkeep
studio/assets/*_cropped.*

# Intermediate context snapshot history (replicated in 2026-project-memory)
events/context-snapshots/snapshot-v*.json

# Runtime generated content artifacts remain local.
runtime/content/*
!runtime/content/.gitkeep

# Keep directory markers only.
!events/incoming/.gitkeep
!events/processed/.gitkeep
!events/dispatch/.gitkeep
!events/proposals/.gitkeep
!events/approvals/.gitkeep
!events/chief-decisions/.gitkeep
!events/night-queue/.gitkeep
!events/morning-reports/.gitkeep
!events/thought-incoming/.gitkeep
!events/thought-processed/.gitkeep
!events/thought-rejected/.gitkeep
!events/thoughts/.gitkeep
!events/agent-states/.gitkeep
!events/locks/.gitkeep
!events/context-snapshots/.gitkeep
!events/context-snapshots/snapshot-current.json
!events/academy/economics.json
